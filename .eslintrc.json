{
  "env": {
    "browser": true,
    "es2017": true,
    "webextensions": true,
    "node": false
  },
  "parserOptions": {
    "ecmaVersion": 2017,
    "sourceType": "script"
  },
  "extends": ["eslint:recommended"],
  "globals": {
    "DevHome": "writable",
    "React": "readonly",
    "ReactDOM": "readonly",
    "dayjs": "readonly",
    "marked": "readonly"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-undef": "error",
    "no-console": "off",
    "no-prototype-builtins": "warn",
    "no-redeclare": "warn",
    "no-empty": ["warn", { "allowEmptyCatch": true }],
    "no-constant-condition": "warn",
    "no-cond-assign": "error",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-irregular-whitespace": "error",
    "no-unreachable": "warn",
    "no-unsafe-finally": "error",
    "no-unsafe-negation": "error",
    "use-isnan": "error",
    "valid-typeof": "error",
    "no-var": "off",
    "prefer-const": "off",
    "strict": ["error", "function"]
  },
  "ignorePatterns": [
    "node_modules/",
    "js/lib/",
    "js/ui-components/",
    "js/bundle.js",
    "js/tiptap-bundle.js"
  ]
}
