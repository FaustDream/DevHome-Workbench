{
  "name": "thrilled",
  "version": "3.0.0",
  "description": "Thrilled — Chrome MV3 新标签页（TypeScript 重构版）",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --prod",
    "release": "node scripts/release.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "prepack": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0",
    "zod": "^3.24.0"
  }
}
