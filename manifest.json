{
  "manifest_version": 3,
  "name": "Thrilled",
  "version": "3.0",
  "description": "新标签页",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "contextMenus",
    "tabs",
    "scripting",
    "geolocation",
    "sidePanel",
    "bookmarks"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
