{
  "manifest_version": 3,
  "name": "DevHome Workbench",
  "version": "2.23.5",
  "author": "凌致",
  "description": "综合性开发工作台——融合任务、笔记、日历、番茄钟、网页剪藏与行为追踪的个人工作操作系统",
    "permissions": [
        "storage",
        "unlimitedStorage",
        "tabs",
        "sidePanel",
        "contextMenus",
        "notifications",
        "alarms",
        "scripting",
        "clipboardRead"
    ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DevHome Workbench"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "js/background.js"
  },
    "host_permissions": [
        "*://api.bing.com/*",
        "*://api.xinac.net/*",
        "*://api.open-meteo.com/*",
        "*://v1.hitokoto.cn/*"
    ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+B"
      },
      "description": "打开弹窗"
    },
    "capture_selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "剪藏选中文字到工作台"
    },
    "open_side_panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+D"
      },
      "description": "打开工作台侧边栏"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["defaults.json"],
      "matches": ["chrome-extension://*/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https://api.bing.com/ https://api.xinac.net/ https://api.open-meteo.com/ https://v1.hitokoto.cn/ https://api.github.com/ https://gh-trending-api.herokuapp.com/; object-src 'self'"
  }
}
